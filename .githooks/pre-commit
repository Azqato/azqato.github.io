#!/bin/sh
#
# Writing-style guard: blocks any commit that introduces an em dash into an
# HTML or documentation file. Enforces the no-em-dash policy documented in the
# Writing Style section of docs/PRD.md.
#
# Checks both forms: the literal Unicode character (U+2014) and the HTML
# entity &mdash;. In Markdown, occurrences inside `backtick` code spans are
# allowed, so the rule's own definition and historical references to the
# character do not trip the guard.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git commit --no-verify
#
# Note: en dashes (U+2013) in numeric or version ranges are permitted by the
# policy and are not checked. Double dashes are not auto-checked because CSS
# custom properties (--var) would produce false positives; review those by eye.

EMDASH=$(printf '\342\200\224')   # U+2014, avoids embedding the literal byte
status=0

# Staged, non-deleted .html and .md files.
# invests/inventory/ is exempt: Azqato Invests' word-for-word records of its
# source pages, which its preserve-everything rule checks the moved pages
# against. They are records, not pages; the pages themselves are checked.
# prompts/md/ is exempt too (item 22): the prompt sources, kept word for word,
# and the Documentation prompt spells out this very rule ("the &mdash; HTML
# entity"). Their generated pages under prompts/ are checked.
files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(html|md)$' | grep -v '^invests/inventory/' | grep -v '^prompts/md/')

for f in $files; do
  content=$(git show ":$f")
  case "$f" in
    *.md)
      # Strip inline code spans so backtick references are exempt.
      scan=$(printf '%s\n' "$content" | sed 's/`[^`]*`//g')
      ;;
    *)
      scan="$content"
      ;;
  esac

  hits=$(printf '%s\n' "$scan" | grep -nE "$EMDASH|&mdash;")
  if [ -n "$hits" ]; then
    if [ "$status" -eq 0 ]; then
      echo "commit blocked: em dash found (see Writing Style in docs/PRD.md)"
      echo ""
    fi
    echo "  $f:"
    printf '%s\n' "$hits" | sed 's/^/    /'
    status=1
  fi
done

# Nav guard: the nav is generated by scripts/build-nav.py (Never do these, in
# docs/PRD.md). Block a commit when any staged page's nav has drifted, so a
# hand edit or a forgotten rerun can't ship.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^[^/]+\.html$'; then
  PY=$(command -v python3 || command -v python)
  if [ -n "$PY" ] && ! "$PY" scripts/build-nav.py --check >/dev/null 2>&1; then
    echo "commit blocked: the nav is out of date in at least one page."
    echo "Run: python scripts/build-nav.py, review the diff, and stage it."
    echo ""
    status=1
  fi
fi

if [ "$status" -ne 0 ]; then
  echo ""
  echo "Replace with a comma, colon, semicolon, parentheses, or period."
  echo "To bypass (not recommended): git commit --no-verify"
fi

exit $status
